{
  "name": "@svgdotjs/svg.draggable.js",
  "version": "3.0.6",
  "description": "An extension for svg.js which allows to drag elements with your mouse",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "main": "dist/svg.draggable.js",
  "module": "dist/svg.draggable.mjs",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/svg.draggable.d.mts",
        "default": "./dist/svg.draggable.mjs"
      },
      "import": {
        "types": "./dist/svg.draggable.d.mts",
        "default": "./dist/svg.draggable.mjs"
      },
      "require": {
        "types": "./dist/svg.draggable.d.ts",
        "default": "./dist/svg.draggable.js"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/svg.draggable.js",
  "jsdelivr": "dist/svg.draggable.js",
  "files": [
    "/dist",
    "!/dist/*.zip"
  ],
  "keywords": [
    "svg.js",
    "draggable",
    "mouse"
  ],
  "bugs": "https://github.com/svgdotjs/svg.draggable.js/issues",
  "license": "MIT",
  "typings": "./dist/svg.draggable.d.ts",
  "author": {
    "name": "Wout Fierens"
  },
  "contributors": [
    {
      "name": "Wout Fierens"
    },
    {
      "name": "Ulrich-Matthias Schäfer"
    }
  ],
  "homepage": "https://github.com/svgdotjs/svg.draggable.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgdotjs/svg.draggable.js.git"
  },
  "scripts": {
    "build": "tsc && vite build",
    "demo": "vite demo",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "fix": "oxfmt --write . && oxlint -D correctness --fix .",
    "lint": "oxfmt --check . && oxlint -D correctness .",
    "prepublishOnly": "rm -rf ./dist && pnpm lint && pnpm build && pnpm zip",
    "zip": "zip -j dist/svg.draggable.js.zip -- LICENSE README.md dist/svg.draggable.js"
  },
  "peerDependencies": {
    "@svgdotjs/svg.js": "^3.0.0"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
